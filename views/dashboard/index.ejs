<div class="container-fluid container-fluid-custom pb-5 mb-5">    
    <div class="row mb-4">
        <div class="col">
            <h1>Hey, <%- userName %></h1>
        </div>
        <div class="col text-end">
            <a type="button" class="btn btn-primary me2" data-bs-toggle="modal" id="addButton" data-bs-target="#addModal">+ Add Meal</a>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-12">
            <div class="card p-4 overview-card shadow-sm">
                <div class="row align-items-center gy-3">
                    <div class="col-md-4">
                        <div class="overview-panel p-4 h-100">
                            <h5 class="mb-2">Quick Actions</h5>
                            <p class="mb-0">Jump into your workout coach or habit tracker without leaving your dashboard.</p>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="card feature-card h-100 p-3">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="feature-icon me-3">💪</div>
                                        <div>
                                            <h5 class="mb-1">AI Form Coach</h5>
                                            <p class="small mb-0">Real-time exercise guidance while you train at home.</p>
                                        </div>
                                    </div>
                                    <a href="/dashboard/fitness-coach" class="btn btn-outline-primary btn-sm">Open</a>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="card feature-card h-100 p-3">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="feature-icon me-3">🧠</div>
                                        <div>
                                            <h5 class="mb-1">Habit Tracker</h5>
                                            <p class="small mb-0">Commit to habits, track streaks, and stay consistent.</p>
                                        </div>
                                    </div>
                                    <a href="/dashboard/commitments" class="btn btn-outline-primary btn-sm">Open</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <% if(meals.length > 0) { for(var i=0; i<meals.length; i++) { %>

            <div class="col-sm-3 mb-4">
                <div class="card" style="min-height: 210px">
                    <a href="/dashboard/item/<%= meals[i]._id %>" class="card-body text-decoration-none">
                        <h5 class="card-title"><%= meals[i].name %></h5>
                        <table class="table">
                            <thead>
                              <tr>
                                <th scope="col">Net</th>
                                <th scope="col">Value</th>

                              </tr>
                            </thead>
                            <tbody>
                              <tr>
                                <th scope="row">Calories</th>
                                <td><%= meals[i].netinf[0] %> Cal</td>
                              </tr>
                              <tr>
                                <th scope="row">Protein</th>
                                <td><%= meals[i].netinf[1] %> g</td>
                              </tr>
                              <tr>
                                <th scope="row">Fat</th>
                                <td><%= meals[i].netinf[2] %> g</td>
                              </tr>
                              <tr>
                                <th scope="row">Carbs</th>
                                <td><%= meals[i].netinf[3] %> g</td>
                              </tr>
                            </tbody>
                          </table>
                    </a>
                </div>
            </div>
       <% }} else { %>

        <div class="row">
            <div class="col-3">
                <img src="img/human-3.svg" alt="human pointing hand">
            </div>
        
            <div class="col mt-md-4">
                <h2>Okay...</h2>
                <h4>Let's start with your first meal!<br/><br/>
                <a href="/dashboard/add" data-bs-toggle="modal" id="createButton" data-bs-target="#addModal">Create One!</a> </h4>
            </div>
        </div>
    <% } %>
    </div>

    <% if(meals.length > 0) { %>
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-center mt-5">

                <% if(current == 1) { %>
                    <li class="page-item"><a class="page-link" href="#">Previous</a></li>
                <% } else { %>
                    <li class="page-item"><a class="page-link" href="/">First</a></li>
                <% } %>

                <% var i = (Number(current) > 5 ? Number(current) - 4 : 1) %>
                <% if(i !== 1) { %>
                    <li class="page-item"><a class="page-link" href="#">...</a></li>
                <% } %>

                <% for(; i <= (Number(current) + 4) && i <= pages; i++) { %>

                    <% if(i == current)  { %>
                        <li class="page-item"><a class="page-link" href="#"><%= i %></a></li>

                    <% } else { %>
                        <li class="page-item"><a class="page-link" href="/dashboard/?page=<%= i %>"><%= i %></a></li>
                    <% } %>

                    <% if (i == Number(current) + 4 && i < pages) { %>
                        <li class="page-item"><a class="page-link" href="#">...</a></li>
                    <% } %>

                    <% if(i == Number(current) + 4 && i < pages) { %>
                        <li class="page-item"><a class="page-link" href="#">...</a></li>
                    <% } %>

                <% } %>

                <% if (current == pages) { %>
                    <li class="page-item disabled"><a class="page-link">Last</a></li>
                <% } else { %>
                    <li class="page-item"><a href="/dashboard/?page=<%= pages %>" class="page-link">Next</a></li>
                <% } %>
            </ul>
        </nav>
    <% } %>


</div>




<div class="modal fade" tabindex="-1" id="addModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Upload photo of meal</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/dashboard/upload" method="POST" enctype="multipart/form-data" class="position-relative">
        <div class="modal-body">
            <div class="input-group mb-3">
                <input type="file" class="form-control" accept="image/*" name="image" id="imageUpload" required>
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          
          <button type="submit" class="btn btn-primary">Upload</button>
        </form>
        </div>
      </div>
    </div>
</div>