<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- locals.title %></title>
    <meta name="description" content="<%- locals.description %>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,700;1,100&family=Unbounded:wght@200..900&display=swap" rel="stylesheet">

</head>
<body class="d-flex flex-column h-100">

    <%- include('../partials/header_dashboard.ejs') %>
    <%- body %>
    <%- include('../partials/footer_dashboard.ejs') %>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@clerk/clerk-js/dist/clerk.browser.js"></script>
    <script>
        window.addEventListener('load', async () => {
            if (window.Clerk && '<%= clerkPublishableKey %>') {
                await window.Clerk.load({ publishableKey: '<%= clerkPublishableKey %>' });

                const refreshSession = async () => {
                    try {
                        if (window.Clerk.session) {
                            await window.Clerk.session.getToken({ skipCache: true });
                        }
                    } catch (error) {
                        console.warn('Clerk periodic token refresh failed:', error?.message || error);
                    }
                };

                // Keep session valid for long-running pages (fitness coach frame loop)
                refreshSession();
                setInterval(refreshSession, 45000);

                document.addEventListener('visibilitychange', () => {
                    if (!document.hidden) {
                        refreshSession();
                    }
                });
            }
        });
    </script>
</body>
</html>