<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- locals.title %></title>
    <meta name="description" content="<%- locals.description %>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,700;1,100&family=Unbounded:wght@200..900&display=swap" rel="stylesheet">

</head>
<body class="page-shell d-flex flex-column h-100">

    <%- include('../partials/header_dashboard.ejs') %>
    <%- body %>
    <%- include('../partials/footer_dashboard.ejs') %>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@clerk/clerk-js/dist/clerk.browser.js"></script>
    <script>
        window.addEventListener('load', async () => {
            if (window.Clerk && '<%= clerkPublishableKey %>') {
                await window.Clerk.load({ publishableKey: '<%= clerkPublishableKey %>' });

                const refreshSession = async () => {
                    try {
                        if (window.Clerk.session) {
                            // Avoid forced refresh loops; use Clerk cache unless needed.
                            await window.Clerk.session.getToken();
                        }
                    } catch (error) {
                        console.warn('Clerk periodic token refresh failed:', error?.message || error);
                    }
                };

                // Keep session valid for long-running pages (fitness coach frame loop)
                refreshSession();
                setInterval(refreshSession, 45000);

                document.addEventListener('visibilitychange', () => {
                    if (!document.hidden) {
                        refreshSession();
                    }
                });

                // Keep auth warm right before any form POST so dashboard actions
                // don't fail due to token/session timing during long sessions.
                document.addEventListener('submit', async (event) => {
                    const form = event.target;
                    if (!form || form.tagName !== 'FORM') return;

                    const method = String(form.method || 'GET').toUpperCase();
                    const needsAuthRefresh = method !== 'GET' || form.action.includes('/dashboard');
                    if (!needsAuthRefresh) return;

                    if (form.dataset.sessionRefreshed === '1') return;

                    event.preventDefault();
                    try {
                        await refreshSession();
                    } catch (error) {
                        console.warn('Pre-submit auth refresh failed:', error?.message || error);
                    } finally {
                        form.dataset.sessionRefreshed = '1';
                        form.submit();
                    }
                }, true);
            }
        });
    </script>
</body>
</html>